# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npx supabase status` after `npx supabase start`.

# Supabase project URL and anon (public) key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used only to delete an account (src/lib/supabase/admin.ts). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: "true" shows "Continue with Google" on log in and sign-up (see README).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
