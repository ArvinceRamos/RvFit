# Copy to .env.local and fill in. Never commit real values. Only EXPO_PUBLIC_ values reach the app,
# and everything in the app is readable by anyone who has it, so never put a secret key here.

# Supabase project URL and anon (public) key: the same values as the web app's NEXT_PUBLIC_ ones.
# Local: http://127.0.0.1:54321 (run `adb reverse tcp:54321 tcp:54321` so the Android emulator reaches it).
# Staging: https://<staging-ref>.supabase.co. Never point a development build at production.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The web app's address. The app calls its /api/account endpoint to delete an account, because
# deleting needs the server-only admin key. Local: http://127.0.0.1:3000 (with `adb reverse tcp:3000 tcp:3000`).
EXPO_PUBLIC_WEB_URL=

# Optional: "true" shows "Continue with Google" on log in and sign-up (see mobile/README.md).
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=
