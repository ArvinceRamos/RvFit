{
  "expo": {
    "name": "RvFit",
    "slug": "rvfit",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rvfit",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#161a18",
    "ios": {
      "bundleIdentifier": "app.rvfit.mobile",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "app.rvfit.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#161a18",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161a18",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
